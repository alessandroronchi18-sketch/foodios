# Copia questo file in .env.local e compila con i tuoi valori

# ─── Supabase (frontend) ──────────────────────────────────────────────────────
VITE_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# Supabase sta sostituendo le chiavi in formato JWT con le nuove
# `sb_publishable_...` (browser) e `sb_secret_...` (server). Vanno nelle STESSE
# variabili: il client le accetta nello stesso posto, non serve cambiare codice.
# Quando le nuove sono in funzione, le vecchie JWT si spengono dal pannello
# Supabase — ed è il modo definitivo di neutralizzare una chiave esposta.
VITE_SUPABASE_ANON_KEY=sb_publishable_...   # oppure la vecchia eyJ...

# ─── Admin email ──────────────────────────────────────────────────────────────
VITE_ADMIN_EMAIL=tua@email.com

# ─── Sentry (opzionale, ma raccomandato in produzione) ────────────────────────
# Il DSN è pubblico per design — l'allowList del dominio si configura nel pannello Sentry.
VITE_SENTRY_DSN=https://KEY@oXXX.ingest.sentry.io/PROJECT_ID

# ─── Variabili SOLO per Vercel (NON mettere in .env.local — vanno nel pannello Vercel) ──
# ANTHROPIC_API_KEY=sk-ant-...
# SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# SUPABASE_SERVICE_KEY=sb_secret_...  ← chiave segreta (o la vecchia service_role eyJ...). NON la chiave pubblica.
# RESEND_API_KEY=re_...
